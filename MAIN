// This is a simplified NLP analysis for fake news detection
// In a production environment, you would use a more sophisticated model

type AnalysisResult = {
  score: number
  credibility: "high" | "medium" | "low"
  reasons: string[]
  suggestions: string[]
}

// Indicators of potential fake news
const sensationalistWords = [
  "shocking",
  "bombshell",
  "outrageous",
  "unbelievable",
  "mind-blowing",
  "jaw-dropping",
  "explosive",
  "stunning",
  "incredible",
  "scandalous",
]

const clickbaitPhrases = [
  "you won't believe",
  "what happens next",
  "will shock you",
  "changed forever",
  "secret",
  "they don't want you to know",
  "this one trick",
  "doctors hate",
  "miracle",
]

const conspiracyTerms = [
  "conspiracy",
  "cover-up",
  "they're hiding",
  "government doesn't want",
  "secret agenda",
  "what they don't tell you",
  "shadow",
  "illuminati",
  "new world order",
  "deep state",
]

export async function analyzeText(content: string, isUrl: boolean): Promise<AnalysisResult> {
  // If it's a URL, we would fetch the content here
  // For this demo, we'll simulate fetching with a delay
  let textToAnalyze = content

  if (isUrl) {
    // Simulate fetching content from URL
    await new Promise((resolve) => setTimeout(resolve, 1500))

    // For demo purposes, we'll use a placeholder text
    // In a real app, you would fetch and parse the actual content
    textToAnalyze =
      "This is simulated content from the URL. We would actually fetch and parse the real content in a production environment."
  }

  // Convert to lowercase for easier matching
  const lowerText = textToAnalyze.toLowerCase()

  // Initialize analysis metrics
  let sensationScore = 0
  let clickbaitScore = 0
  let conspiracyScore = 0
  const reasons: string[] = []
  const suggestions: string[] = []

  // Check for sensationalist language
  const sensationalistCount = sensationalistWords.filter((word) => lowerText.includes(word.toLowerCase())).length
  sensationScore = Math.min(sensationalistCount / 3, 1)

  // Check for clickbait phrases
  const clickbaitCount = clickbaitPhrases.filter((phrase) => lowerText.includes(phrase.toLowerCase())).length
  clickbaitScore = Math.min(clickbaitCount / 2, 1)

  // Check for conspiracy terms
  const conspiracyCount = conspiracyTerms.filter((term) => lowerText.includes(term.toLowerCase())).length
  conspiracyScore = Math.min(conspiracyCount / 2, 1)

  // Check for source citations (simplified)
  const hasSources =
    lowerText.includes("according to") ||
    lowerText.includes("source") ||
    lowerText.includes("study") ||
    lowerText.includes("research")

  // Check for balanced reporting (simplified)
  const hasBalancedView =
    lowerText.includes("however") || lowerText.includes("on the other hand") || lowerText.includes("alternatively")

  // Calculate overall credibility score (0-1)
  // Lower score means higher likelihood of fake news
  let credibilityScore = 1.0

  // Reduce score based on negative indicators
  credibilityScore -= sensationScore * 0.2
  credibilityScore -= clickbaitScore * 0.3
  credibilityScore -= conspiracyScore * 0.3

  // Increase score for positive indicators
  if (hasSources) credibilityScore += 0.15
  if (hasBalancedView) credibilityScore += 0.15

  // Ensure score stays within 0-1 range
  credibilityScore = Math.max(0, Math.min(1, credibilityScore))

  // Determine credibility level
  let credibility: "high" | "medium" | "low"
  if (credibilityScore >= 0.7) {
    credibility = "high"
  } else if (credibilityScore >= 0.4) {
    credibility = "medium"
  } else {
    credibility = "low"
  }

  // Generate reasons for the analysis
  if (sensationalistCount > 0) {
    reasons.push(`Contains ${sensationalistCount} sensationalist terms that may exaggerate the content.`)
  }

  if (clickbaitCount > 0) {
    reasons.push(`Contains ${clickbaitCount} clickbait phrases typically used to attract attention.`)
  }

  if (conspiracyCount > 0) {
    reasons.push(`Contains ${conspiracyCount} conspiracy-related terms that may indicate unsubstantiated claims.`)
  }

  if (!hasSources) {
    reasons.push("No clear references to sources or studies to back up claims.")
  }

  if (!hasBalancedView) {
    reasons.push("Lacks balanced perspective or consideration of alternative viewpoints.")
  }

  if (reasons.length === 0) {
    reasons.push("No clear indicators of fake news were detected in the text.")
  }

  // Generate suggestions
  if (credibility !== "high") {
    suggestions.push("Verify this information with established news sources.")
    suggestions.push("Look for articles that cite specific studies, experts, or primary sources.")

    if (!hasSources) {
      suggestions.push("Check if the original article provides references or links to its sources.")
    }

    if (!hasBalancedView) {
      suggestions.push("Seek out alternative perspectives on this topic for a more complete understanding.")
    }
  }

  return {
    score: credibilityScore,
    credibility,
    reasons,
    suggestions,
  }
}
